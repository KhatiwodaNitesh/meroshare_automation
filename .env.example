# Local single-user configuration.
# For development, set these variables.
# For GitHub Actions, the workflow already sets the default URL and exports numbered AUTOMATION_USER_N secrets.
URL=https://meroshare.cdsc.com.np/#/
DP_NAME=YOUR_DP_NAME
MS_USERNAME=YOUR_USERNAME
MS_PASSWORD=YOUR_PASSWORD

DMAT_BANK_NAME=YOUR_BANK_NAME
CRN_NO=YOUR_CRN_NO
KITTA_NO=YOUR_KITTA_NO
TRANS_PIN=YOUR_TRANSACTION_PIN

# GitHub Actions: Set numbered user configuration secrets (pattern: AUTOMATION_USER_N where N is any number)
# The runner automatically discovers every AUTOMATION_USER_N environment variable exported by the workflow.
# GitHub Actions cannot read repository secrets dynamically, so each secret must still be mapped in .github/workflows/daily.yml.
#
# Each secret should be a JSON object with required fields:
# - dpName: DP provider name
# - username: MeroShare username (hidden in logs)
# - password: MeroShare password (hidden in logs)
# - bankName: Bank name for transaction
# - crn: Client Registration Number
# - kitta: Kitta number
# - transactionPin: Transaction PIN (hidden in logs)
# - id: Optional custom user ID (defaults to user-N if not provided)
#
# Example structure (usernames/passwords masked for security):
# AUTOMATION_USER_1={"dpName":"NABIL","username":"***","password":"***","bankName":"NABIL","crn":"12345","kitta":"100","transactionPin":"***"}
# AUTOMATION_USER_2={"dpName":"NIC","username":"***","password":"***","bankName":"NIC","crn":"67890","kitta":"200","transactionPin":"***"}
# AUTOMATION_USER_50={"dpName":"SBI","username":"***","password":"***","bankName":"SBI","crn":"11111","kitta":"300","transactionPin":"***"}
#
# To add more users:
# 1. Create new GitHub secrets: AUTOMATION_USER_21, AUTOMATION_USER_22, etc.
# 2. Extend the workflow env block so those secrets are exported to the runner.
# 3. Run `node scripts/generate-workflow-secrets.mjs --start 21 --count 10` to generate the YAML entries.
# 4. The runner will automatically discover every exported secret with a value.
# 5. Update the workflow URL only if the MeroShare target changes.
