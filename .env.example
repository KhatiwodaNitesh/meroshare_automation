MS_USERNAME=YOUR_USERNAME
MS_PASSWORD=YOUR_PASSWORD

DMAT_BANK_NAME=YOUR_BANK_NAME
CRN_NO=YOUR_CRN_NO
KITTA_NO=YOUR_KITTA_NO
TRANS_PIN=YOUR_TRANSACTION_PIN
